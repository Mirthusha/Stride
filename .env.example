# ==========================================
# STRIDE CONFIGURATION (.env.example)
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase PostgreSQL & Auth Credentials
# When configured, Stride runs in full cloud multi-user mode with RLS & Realtime.
# When omitted, Stride runs in Stride Local Engine mode with persistent disk storage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Frontend Vite Environment Variables (in client/.env)
# VITE_API_BASE_URL=http://localhost:4000/api
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
